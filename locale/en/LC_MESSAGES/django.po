#: apps/classroom/quiz_bank.py
msgid "// butun bo‘lish: kasr qismi tashlanadi."
msgstr "// is integer division: the fractional part is dropped."

#: apps/classroom/quiz_bank.py
msgid "% bo‘lishdagi qoldiq: 7 = 2·3 + 1."
msgstr "% is the remainder of division: 7 = 2·3 + 1."

#: apps/classroom/quiz_bank.py
msgid "** daraja: 2³ = 8, keyin + 1."
msgstr "** is the power: 2³ = 8, then + 1."

#: apps/classroom/quiz_bank.py apps/classroom/quiz_bank.py
msgid "Satrni songa ko‘paytirish uni takrorlaydi."
msgstr "Multiplying a string by a number repeats it."

#: apps/classroom/quiz_bank.py
msgid "5 + 3 = 8, keyin 8 · 2 = 16."
msgstr "5 + 3 = 8, then 8 · 2 = 16."

#: apps/classroom/quiz_bank.py
msgid "len satrdagi belgilar soni."
msgstr "len is the number of characters in the string."

#: apps/classroom/quiz_bank.py
msgid "/ doim haqiqiy son beradi."
msgstr "/ always gives a real number."

#: apps/classroom/quiz_bank.py
msgid "Ikki satr qo‘shilsa, yonma-yon yoziladi."
msgstr "Adding two strings writes them side by side."

#: apps/classroom/quiz_bank.py
msgid "int(\"12\") satrni songa aylantiradi."
msgstr "int(\"12\") turns the string into a number."

#: apps/classroom/quiz_bank.py
msgid "Toq sonning 2 ga bo‘lgandagi qoldig‘i 1."
msgstr "An odd number leaves remainder 1 when divided by 2."

#: apps/classroom/quiz_bank.py
msgid "and: ikkala shart ham to‘g‘ri bo‘lishi kerak."
msgstr "and: both conditions must be true."

#: apps/classroom/quiz_bank.py
msgid "s[0] birinchi, s[-1] oxirgi belgi."
msgstr "s[0] is the first character, s[-1] the last."

#: apps/classroom/quiz_bank.py
msgid "range(4): 0, 1, 2, 3 — 4 kirmaydi."
msgstr "range(4): 0, 1, 2, 3 — 4 is not included."

#: apps/classroom/quiz_bank.py
msgid "Birinchi shartdan keyin x = 5; 5 > 3, demak x = 10."
msgstr "After the first condition x = 5; 5 > 3, so x = 10."

#: apps/classroom/quiz_bank.py
msgid "round(son, 1) — verguldan keyin bitta xona."
msgstr "round(number, 1) — one digit after the decimal point."

#: apps/classroom/quiz_bank.py
msgid "9 − 3 = 6."
msgstr "9 − 3 = 6."

#: apps/classroom/quiz_bank.py
msgid "\"5\" satr: ikki marta takrorlanadi."
msgstr "\"5\" is a string: it is repeated twice."

#: apps/classroom/quiz_bank.py
msgid "15 = 3·4 + 3: qoldiq 3."
msgstr "15 = 3·4 + 3: the remainder is 3."

#: apps/classroom/quiz_bank.py
msgid "Avval a = 5, keyin 5 · 5 = 25."
msgstr "First a = 5, then 5 · 5 = 25."

#: apps/classroom/quiz_bank.py
msgid "+ satrlarni ulaydi; o‘rtadagi \" \" — bitta bo‘sh joy."
msgstr "+ joins strings; the \" \" in the middle is a single space."

#: apps/classroom/quiz_bank.py
msgid "Nuqtali son — float (haqiqiy son)."
msgstr "A number with a decimal point is a float (a real number)."

#: apps/classroom/quiz_bank.py
msgid "upper() hamma harfni katta qiladi."
msgstr "upper() makes every letter a capital."

#: apps/classroom/quiz_bank.py
msgid "or: bittasi to‘g‘ri bo‘lsa yetadi; 8 > 5."
msgstr "or: one true condition is enough; 8 > 5."

#: apps/classroom/quiz_bank.py
msgid "abs(-9) = 9, keyin + 1."
msgstr "abs(-9) = 9, then + 1."

#: apps/classroom/quiz_bank.py
msgid "print vergul bilan ajratilgan qismlar orasiga bitta bo‘sh joy qo‘yadi."
msgstr "print puts a single space between the parts separated by commas."

#: apps/classroom/quiz_bank.py
msgid "lower() hamma harfni kichik qiladi; teng chiqadi."
msgstr "lower() makes every letter lowercase; they come out equal."

#: apps/classroom/quiz_bank.py
msgid "range(1, 4): 1, 2, 3 — 4 kirmaydi."
msgstr "range(1, 4): 1, 2, 3 — 4 is not included."

#: apps/classroom/quiz_bank.py
msgid ""
"float() butun sonni haqiqiy songa aylantiradi: nuqta va nol bilan chiqadi."
msgstr ""
"float() turns an integer into a real number: it prints with a point and a "
"zero."

#: apps/classroom/quiz_bank.py
msgid "Avval ko‘paytirish: 2·3 = 6, keyin 10 − 6 = 4."
msgstr "Multiplication first: 2·3 = 6, then 10 − 6 = 4."

#: apps/classroom/quiz_bank.py
msgid "1 + 2 + 3 + 4; range(1, 5) da 5 yo‘q."
msgstr "1 + 2 + 3 + 4; range(1, 5) does not include 5."

#: apps/classroom/quiz_bank.py
msgid "a[1:4] — 1-, 2-, 3-indekslar; 4 kirmaydi."
msgstr "a[1:4] — indexes 1, 2, 3; 4 is not included."

#: apps/classroom/quiz_bank.py
msgid "Saralangandan keyin oxirgisi eng kattasi."
msgstr "After sorting, the last one is the largest."

#: apps/classroom/quiz_bank.py
msgid "split() so‘zlarga ajratadi, [1] — ikkinchisi."
msgstr "split() breaks it into words, [1] is the second one."

#: apps/classroom/quiz_bank.py
msgid "4 + 7 + 1 + 9 = 21."
msgstr "4 + 7 + 1 + 9 = 21."

#: apps/classroom/quiz_bank.py
msgid "[::-1] satrni teskari o‘qiydi."
msgstr "[::-1] reads the string backwards."

#: apps/classroom/quiz_bank.py
msgid "5·5 = 25 < 30, 6·6 = 36 — sikl to‘xtaydi."
msgstr "5·5 = 25 < 30, 6·6 = 36 — the loop stops."

#: apps/classroom/quiz_bank.py
msgid "f(2) = 5, f(5) = 11."
msgstr "f(2) = 5, f(5) = 11."

#: apps/classroom/quiz_bank.py
msgid "1 + 4 + 9 = 14."
msgstr "1 + 4 + 9 = 14."

#: apps/classroom/quiz_bank.py
msgid "join oraliqqa shu satrni qo‘yadi."
msgstr "join puts this string between the items."

#: apps/classroom/quiz_bank.py
msgid "d[\"a\"] endi 5: 5 + 2."
msgstr "d[\"a\"] is now 5: 5 + 2."

