COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_STRING
ALLOWED_HOSTS=codearena.uz,www.codearena.uz
CSRF_TRUSTED_ORIGINS=https://codearena.uz,https://www.codearena.uz
USE_HTTPS=1
POSTGRES_HOST=db
POSTGRES_DB=codearena
POSTGRES_USER=codearena
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
REDIS_URL=redis://redis:6379/0
JUDGE_WORK_DIR=/var/codearena/work
# Gunicorn: sync-worker count x threads = concurrent HTTP requests (status polling is 1 req/s per open submission page).
WEB_WORKERS=5
WEB_THREADS=6
# Parallel judge processes; each submission runs in one container pinned to 1 CPU. ~= host CPU count.
JUDGE_WORKERS=6
