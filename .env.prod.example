COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_STRING
ALLOWED_HOSTS=SERVER_IP
CSRF_TRUSTED_ORIGINS=http://SERVER_IP:2009
USE_HTTPS=0
POSTGRES_HOST=db
POSTGRES_DB=codearena
POSTGRES_USER=codearena
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
REDIS_URL=redis://redis:6379/0
JUDGE_WORK_DIR=/var/codearena/work
# Host port the site is served on.
WEB_PORT=2009
# Gunicorn: sync-worker count x threads = concurrent HTTP requests (status polling is 1 req/s per open submission page).
WEB_WORKERS=3
WEB_THREADS=8
# Parallel judge processes. Each test runs in a docker container pinned to 1 CPU; keep <= host CPU count - 1.
JUDGE_WORKERS=4
