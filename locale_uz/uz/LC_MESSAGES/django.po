msgid ""
"Masalani kodlashdan oldin kirish va chiqish formatini o‘qing. Kichik misolni"
" qo‘lda yechib, algoritm nima qilishi kerakligini aniqlang."
msgstr ""
"Masalani kodlaşdan oldin kiriş va çiqiş formatini öqing. Kiçik misolni qölda"
" yeçib, algoritm nima qilişi kerakligini aniqlang."

msgid ""
"Chekka holatlarni tekshiring: n=1, eng kichik qiymatlar, takroriy sonlar va "
"javob chegaralari ko‘p xatolarni topadi."
msgstr ""
"Çekka holatlarni tekşiring: n=1, eng kiçik qiymatlar, takroriy sonlar va "
"javob çegaralari köp xatolarni topadi."

msgid ""
"Murakkablikni baholang: n 10⁵ bo‘lsa, O(n²) algoritm odatda sekinlik qiladi."
" Avval yechimning vaqt va xotira sarfini hisoblang."
msgstr ""
"Murakkablikni baholang: n 10⁵ bölsa, O(n²) algoritm odatda sekinlik qiladi. "
"Avval yeçimning vaqt va xotira sarfini hisoblang."

msgid ""
"Katta yechimdan oldin kichik brute-force yozib ko‘ring. Tasodifiy kichik "
"testlarda tez algoritm bilan solishtirish xatolarni topishga yordam beradi."
msgstr ""
"Katta yeçimdan oldin kiçik brute-force yozib köring. Tasodifiy kiçik "
"testlarda tez algoritm bilan soliştiriş xatolarni topişga yordam beradi."

msgid ""
"Xato javob chiqsa, bir o‘zgarishni tekshiring: oraliq qiymatlar, sikl "
"chegarasi va indekslar. Debug chiqarishlarini yakuniy javobdan olib "
"tashlang."
msgstr ""
"Xato javob çiqsa, bir özgarişni tekşiring: oraliq qiymatlar, sikl çegarasi "
"va indekslar. Debug çiqarişlarini yakuniy javobdan olib taşlang."

msgid ""
"Yechimni topshirishdan oldin namunadan tashqari o‘zingiz tuzgan kamida bitta"
" testda ham sinang."
msgstr ""
"Yeçimni topşirişdan oldin namunadan taşqari özingiz tuzgan kamida bitta "
"testda ham sinang."

msgid ""
"Masalani yechgach, boshqa yechimni o‘qing va o‘zingiznikiga solishtiring. "
"Yangi g‘oyani keyingi masalada qo‘llab ko‘ring."
msgstr ""
"Masalani yeçgaç, boşqa yeçimni öqing va özingiznikiga soliştiring. Yangi "
"ğoyani keyingi masalada qöllab köring."

