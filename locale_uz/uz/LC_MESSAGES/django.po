msgid "This is not a valid IPv6 address."
msgstr "Bu töğri IPv6 manzili emas."

msgid "CSRF verification failed. Request aborted."
msgstr "CSRF tekşiruvi amalga oşmadi. Sörov bekor qilindi."

msgid ""
"If you have configured your browser to disable “Referer” headers, please re-"
"enable them, at least for this site, or for HTTPS connections, or for “same-"
"origin” requests."
msgstr ""
"Agar siz \"Referer\" sarlavhalarini öçirib qöyiş uçun brauzeringizni "
"sozlagan bölsangiz, iltimos, heç bölmasa uşbu sayt uçun, HTTPS ulanişlari, "
"yoki \"same-origin\" sörovlari uçun ularni qayta yoqib qöying."

msgid ""
"If you are using the <meta name=\"referrer\" content=\"no-referrer\"> tag or"
" including the “Referrer-Policy: no-referrer” header, please remove them. "
"The CSRF protection requires the “Referer” header to do strict referer "
"checking. If you’re concerned about privacy, use alternatives like <a "
"rel=\"noreferrer\" …> for links to third-party sites."
msgstr ""
"Agar siz <meta name=\"referrer\" content=\"no-referrer\"> yorliğidan yoki "
"\"Referrer-Policy: no-referer\" sarlavhasidan  foydalanayotgan bölsangiz, "
"iltimos ularni olib taşlang. CSRF himoyasi \"Referer\" sarlavhasini "
"havolalarni qat'iy tekşirişni talab qiladi. Agar maxfiyligingiz haqida "
"xavotirda bölsangiz, uçinçi tomon saytlari <a rel=\"noreferrer\" …> kabi "
"havola alternativalaridan foydalaning."

msgid ""
"You are seeing this message because this site requires a CSRF cookie when "
"submitting forms. This cookie is required for security reasons, to ensure "
"that your browser is not being hijacked by third parties."
msgstr ""
"Siz uşbu xabarni körmoqdasiz, çunki uşbu sayt formalarni yuborişda CSRF "
"cookie ma'lumotlarini talab qiladi. Uşbu cookie ma'lumotlari xavfsizlik "
"nuqtai nazaridan, brauzeringizni uçinçi şaxslar tomonidan öğirlanmasligini "
"ta'minlaş uçun xizmat qilinadi."

msgid ""
"If you have configured your browser to disable cookies, please re-enable "
"them, at least for this site, or for “same-origin” requests."
msgstr ""
"Agar siz cookie ma'lumotlarni öçirib qöyiş uçun brauzeringizni "
"konfiguratsiya qilgan bölsangiz, iltimos, uşbu sayt yoki \"same-origin\" "
"sörovlari uçun ularni qayta yoqib qöying."

msgid "More information is available with DEBUG=True."
msgstr "Qöşimça ma'lumotlarni DEBUG = True ifodasi bilan köriş mumkin."

msgid "No year specified"
msgstr "Yil körsatilmagan"

msgid "Date out of range"
msgstr "Sana çegaradan taşqarida"

msgid "No month specified"
msgstr "Oy körsatilmagan"

msgid "No day specified"
msgstr "Heç qanday kun körsatilmagan"

msgid "No week specified"
msgstr "Heç qanday hafta belgilanmagan"

msgid "No %(verbose_name_plural)s available"
msgstr "Heç qanday %(verbose_name_plural)s lar mavjud emas"

msgid ""
"Future %(verbose_name_plural)s not available because "
"%(class_name)s.allow_future is False."
msgstr ""
"Kelajak %(verbose_name_plural)s lari mavjud emas, çunki "
"%(class_name)s.allow_future yolğondur."

msgid "Invalid date string “%(datestr)s” given format “%(format)s”"
msgstr ""
"\"%(datestr)s\" sana birikmasi notöğri berilgan. \"%(format)s\" formati "
"tavsiya etilgan"

msgid "No %(verbose_name)s found matching the query"
msgstr "Sörovga mos keladigan %(verbose_name)s topilmadi"

msgid "Page is not “last”, nor can it be converted to an int."
msgstr "Sahifa \"oxirgi\" emas va uni butun songa aylantiriş mumkin emas."

msgid "Invalid page (%(page_number)s): %(message)s"
msgstr "Notöğri sahifa (%(page_number)s): %(message)s"

msgid "Empty list and “%(class_name)s.allow_empty” is False."
msgstr "Böş röyxat va \"%(class_name)s.allow_empty\" yolğon."

msgid "Directory indexes are not allowed here."
msgstr "Bu yerda katalog indekslaridan foydalanib bölmaydi."

msgid "The install worked successfully! Congratulations!"
msgstr "Örnatiş muvaffaqiyatli amalga oşdi! Tabriklaymiz!"

msgid ""
"View <a href=\"https://docs.djangoproject.com/en/%(version)s/releases/\" "
"target=\"_blank\" rel=\"noopener\">release notes</a> for Django %(version)s"
msgstr ""
"Django %(version)s uçun  çiqarilgan<a "
"href=\"https://docs.djangoproject.com/en/%(version)s/releases/\" "
"target=\"_blank\" rel=\"noopener\"> naşrlarni</a> köriş"

msgid ""
"You are seeing this page because <a "
"href=\"https://docs.djangoproject.com/en/%(version)s/ref/settings/#debug\" "
"target=\"_blank\" rel=\"noopener\">DEBUG=True</a> is in your settings file "
"and you have not configured any URLs."
msgstr ""
"Siz uşbu sahifani körmoqdasiz, çunki <a "
"href=\"https://docs.djangoproject.com/en/%(version)s/ref/settings/#debug\" "
"target=\"_blank\" rel=\"noopener\">DEBUG = True ifodasi</a> sizning "
"sozlamalar faylingizda körsatilgan va siz biron bir URL manzilini tögri "
"sozlamagansiz."

msgid "Topics, references, &amp; how-to’s"
msgstr "Mavzular, havolalar va qanday qiliş yöllari"

msgid "Tutorial: A Polling App"
msgstr "Qöllanma: Sörovnoma"

msgid "Get started with Django"
msgstr "Django bilan boşlang"

msgid "Connect, get help, or contribute"
msgstr "Boğlaning, yordam oling yoki hissa qöşing"
