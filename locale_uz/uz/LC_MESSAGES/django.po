msgstr "<b>%(e_items)s ta</b> masala yeçdi:"

msgid "«%(e_items_0_badge)s · %(e_items_0_level)s» nishonini oldi"
msgstr "«%(e_items_0_badge)s · %(e_items_0_level)s» nişonini oldi"

