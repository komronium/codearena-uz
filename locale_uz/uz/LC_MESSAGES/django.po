msgstr ""
"Kelajak %(verbose_name_plural)s lari mavjud emas, çunki "
"%(class_name)s.allow_future yolğondur."

msgid "Invalid date string “%(datestr)s” given format “%(format)s”"
msgstr ""
"\"%(datestr)s\" sana birikmasi notöğri berilgan. \"%(format)s\" formati "
