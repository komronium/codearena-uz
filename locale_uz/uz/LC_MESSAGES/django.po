msgstr "Notöğri sahifa (%(page_number)s): %(message)s"

msgid "Empty list and “%(class_name)s.allow_empty” is False."
msgstr "Böş röyxat va \"%(class_name)s.allow_empty\" yolğon."

msgid "Directory indexes are not allowed here."
msgstr "Bu yerda katalog indekslaridan foydalanib bölmaydi."

msgid "The install worked successfully! Congratulations!"
msgstr "Örnatiş muvaffaqiyatli amalga oşdi! Tabriklaymiz!"

