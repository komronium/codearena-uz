msgstr "<b>%(e_items)s ta</b> nişon oldi:"

msgid "So‘nggi %(days)s kunda hech narsa bo‘lmadi."
msgstr "Sönggi %(days)s kunda heç narsa bölmadi."

msgid ""
"CodeArena'dagi har bir ball va har bir o‘rin — egasining o‘z mehnati. Shu "
"qoidalar buni kafolatlaydi."
msgstr ""
"CodeArena'dagi har bir ball va har bir örin — egasining öz mehnati. Şu "
"qoidalar buni kafolatlaydi."

msgid "Dars materiallari, kitob, dasturlash tilining hujjatlari (docs)."
msgstr "Dars materiallari, kitob, dasturlaş tilining hujjatlari (docs)."

msgid "Sintaksisni qidirish: «Pythonda ro‘yxat qanday saralanadi?»"
msgstr "Sintaksisni qidiriş: «Pythonda röyxat qanday saralanadi?»"

msgid "O‘qituvchidan yoki do‘stdan <b>g‘oyani</b> so‘rash (kodni emas)."
msgstr "Öqituvçidan yoki döstdan <b>ğoyani</b> söraş (kodni emas)."

msgid "AI'dan mavzuni tushuntirib berishni so‘rash — masalaning o‘zini emas."
msgstr "AI'dan mavzuni tuşuntirib berişni söraş — masalaning özini emas."

msgid ""
"O‘rta va qiyin masalalarda kodni o‘z muharriringizda yozib, keyin qo‘yish."
msgstr ""
"Örta va qiyin masalalarda kodni öz muharriringizda yozib, keyin qöyiş."

msgid ""
"Masala shartini AI'ga (ChatGPT, Gemini, Copilot va boshqalar) berib, kod "
"yozdirish."
msgstr ""
"Masala şartini AI'ga (ChatGPT, Gemini, Copilot va boşqalar) berib, kod "
"yozdiriş."

msgid ""
"Boshqa odamning yoki internetdagi tayyor yechimni ko‘chirish, «biroz "
"o‘zgartirib» bo‘lsa ham."
msgstr ""
"Boşqa odamning yoki internetdagi tayyor yeçimni köçiriş, «biroz özgartirib» "
"bölsa ham."

msgid "O‘z yechimingizni boshqalarga berish."
msgstr "Öz yeçimingizni boşqalarga beriş."

msgid "Birovning akkauntidan yoki birov bilan bitta akkauntdan ishlash."
msgstr "Birovning akkauntidan yoki birov bilan bitta akkauntdan işlaş."

msgid ""
"Musobaqada: har qanday tashqi yordam — AI, boshqa oyna, telefon, "
"maslahatchi."
msgstr ""
"Musobaqada: har qanday taşqi yordam — AI, boşqa oyna, telefon, maslahatçi."

msgid ""
"Mashq va musobaqada muharrir kod qanday yozilganini qayd etadi: uzun kod "
"qo‘yish, boshqa oynaga o‘tish, kodning har 10 soniyadagi holati. Server "
"qabul qilingan kodni shu yozuvlar bilan solishtiradi, talabalar yechimlarini"
" bir-biri bilan ham solishtiradi. Bularni hakamlar va adminlar ko‘radi, "
"boshqa hech kim emas."
msgstr ""
"Maşq va musobaqada muharrir kod qanday yozilganini qayd etadi: uzun kod "
"qöyiş, boşqa oynaga ötiş, kodning har 10 soniyadagi holati. Server qabul "
"qilingan kodni şu yozuvlar bilan soliştiradi, talabalar yeçimlarini bir-biri"
" bilan ham soliştiradi. Bularni hakamlar va adminlar köradi, boşqa heç kim "
"emas."

msgid ""
"<b class=\"text-ink\">Mashqda</b> — ko‘chirilgan deb topilgan yechim uchun "
"amaliyot bali berilmaydi."
msgstr ""
"<b class=\"text-ink\">Maşqda</b> — köçirilgan deb topilgan yeçim uçun "
"amaliyot bali berilmaydi."

msgid ""
"<b class=\"text-ink\">Musobaqada, bitta masalada</b> — o‘sha masala natijasi"
" bekor qilinadi: unga ball berilmaydi, qolgan masalalaringiz natijasi "
"saqlanadi."
msgstr ""
"<b class=\"text-ink\">Musobaqada, bitta masalada</b> — öşa masala natijasi "
"bekor qilinadi: unga ball berilmaydi, qolgan masalalaringiz natijasi "
"saqlanadi."

msgid ""
"<b class=\"text-ink\">Bir nechta masalada</b>, birovning o‘rniga ishlash "
"yoki bitta qurilmada ikki kishi qatnashsa — diskvalifikatsiya: natija oxirgi"
" o‘ringa tushadi, reyting pasayadi."
msgstr ""
"<b class=\"text-ink\">Bir neçta masalada</b>, birovning örniga işlaş yoki "
"bitta qurilmada ikki kişi qatnaşsa — diskvalifikatsiya: natija oxirgi öringa"
" tuşadi, reyting pasayadi."

msgid "<b class=\"text-ink\">Takrorlansa</b> — hisob bloklanishi mumkin."
msgstr "<b class=\"text-ink\">Takrorlansa</b> — hisob bloklanişi mumkin."

msgid ""
"Tizim hech kimni o‘zi jazolamaydi: belgilar faqat shubha. Qarorni admin yoki"
" hakam kodni ko‘rib chiqib qabul qiladi. E’tirozingiz bo‘lsa, musobaqa "
"tugaganidan keyin 48 soat ichida unga murojaat qiling: qaror bekor qilinishi"
" mumkin."
msgstr ""
"Tizim heç kimni özi jazolamaydi: belgilar faqat şubha. Qarorni admin yoki "
"hakam kodni körib çiqib qabul qiladi. E’tirozingiz bölsa, musobaqa "
"tugaganidan keyin 48 soat içida unga murojaat qiling: qaror bekor qilinişi "
"mumkin."

msgid "Men yechimlarimni o‘zim yozaman va bu qoidalarga amal qilaman."
msgstr "Men yeçimlarimni özim yozaman va bu qoidalarga amal qilaman."

msgid "Reyting qanday ishlaydi"
msgstr "Reyting qanday işlaydi"

msgid ""
"CodeArena'da musobaqa reytingi, rasmiy reyting, amaliyot balli, duel "
"reytingi va nishonlar qanday hisoblanadi."
msgstr ""
"CodeArena'da musobaqa reytingi, rasmiy reyting, amaliyot balli, duel "
"reytingi va nişonlar qanday hisoblanadi."

msgid ""
"CodeArena'da to‘rt xil raqam bor. Ularning har biri o‘z ishi uchun va bir-"
"biriga ta’sir qilmaydi."
msgstr ""
"CodeArena'da tört xil raqam bor. Ularning har biri öz işi uçun va bir-biriga"
" ta’sir qilmaydi."

msgid ""
"Reytingli musobaqadan keyin o‘zgaradi: o‘rningiz o‘z darajangizdagi "
"o‘yinchilardan kutilganidan yaxshi bo‘lsa, ko‘tariladi, yomon bo‘lsa, "
"tushadi (Codeforces/Elo usuli). Birinchi 6 ta musobaqada yangilarga "
"qo‘shimcha «ramp» beriladi. Bu raqam jadvaldagi o‘rin va darajani "
"belgilaydi."
msgstr ""
"Reytingli musobaqadan keyin özgaradi: örningiz öz darajangizdagi "
"öyinçilardan kutilganidan yaxşi bölsa, kötariladi, yomon bölsa, tuşadi "
"(Codeforces/Elo usuli). Birinçi 6 ta musobaqada yangilarga qöşimça «ramp» "
"beriladi. Bu raqam jadvaldagi örin va darajani belgilaydi."

msgid ""
"Reyting faqat <b>reytingli</b> raundlarda o‘zgaradi: «Mashq» raundlari "
"ta’sir qilmaydi."
msgstr ""
"Reyting faqat <b>reytingli</b> raundlarda özgaradi: «Maşq» raundlari ta’sir "
"qilmaydi."

msgid ""
"Hech narsa yubormagan ishtirokchi «qatnashmagan» hisoblanadi va reytingi "
"o‘zgarmaydi."
msgstr ""
"Heç narsa yubormagan iştirokçi «qatnaşmagan» hisoblanadi va reytingi "
"özgarmaydi."

msgid ""
"Emailingiz tasdiqlanmagan bo‘lsa, raundga yozila olasiz, lekin reytingga "
"hisoblanmaysiz."
msgstr ""
"Emailingiz tasdiqlanmagan bölsa, raundga yozila olasiz, lekin reytingga "
"hisoblanmaysiz."

msgid ""
"So‘nggi 90 kunda reytingli musobaqada qatnashmagan odam jadvaldan "
"yashiriladi; reytingi saqlanadi va yangi raunddan keyin qaytadi."
msgstr ""
"Sönggi 90 kunda reytingli musobaqada qatnaşmagan odam jadvaldan yaşiriladi; "
"reytingi saqlanadi va yangi raunddan keyin qaytadi."

msgid ""
"Diskvalifikatsiya qilingan ishtirokchi oxirgi o‘ringa tushadi, reyting faqat"
" pasayadi. Bunday qaror kech chiqsa, shu raunddan keyingi raundlar ham qayta"
" hisoblanadi."
msgstr ""
"Diskvalifikatsiya qilingan iştirokçi oxirgi öringa tuşadi, reyting faqat "
"pasayadi. Bunday qaror keç çiqsa, şu raunddan keyingi raundlar ham qayta "
"hisoblanadi."

msgid ""
"Shaxsi adminlar tomonidan tasdiqlangan o‘yinchilar uchun, <b>rasmiy</b> deb "
"belgilangan musobaqalardan alohida hisoblanadi. Maktab va tashkilotlar "
"shunga tayanadi. Profilda ochiq reyting yonida «rasmiy» raqami ko‘rinadi."
msgstr ""
"Şaxsi adminlar tomonidan tasdiqlangan öyinçilar uçun, <b>rasmiy</b> deb "
"belgilangan musobaqalardan alohida hisoblanadi. Maktab va taşkilotlar şunga "
"tayanadi. Profilda oçiq reyting yonida «rasmiy» raqami körinadi."

msgid ""
"Faqat sizga ko‘rinadigan shaxsiy hisob (jadvalda o‘rin yo‘q): masala "
"yechganingiz uchun beriladi, qiyinroq va kamroq odam yechgan masala ko‘proq "
"ball beradi. Ball masala yechilgan paytdagi narxda <b>muzlatiladi</b>: keyin"
" boshqalar yechgani yoki xato qilgani sizning ballingizni o‘zgartirmaydi. "
"Faqat birinchi mos qabul qilingan yechim hisoblanadi. Musobaqa masalalari "
"raund e’lon qilingandan keyin hisobga o‘tadi. Ko‘chirilgan deb topilgan "
"yechimga ball berilmaydi."
msgstr ""
"Faqat sizga körinadigan şaxsiy hisob (jadvalda örin yöq): masala yeçganingiz"
" uçun beriladi, qiyinroq va kamroq odam yeçgan masala köproq ball beradi. "
"Ball masala yeçilgan paytdagi narxda <b>muzlatiladi</b>: keyin boşqalar "
"yeçgani yoki xato qilgani sizning ballingizni özgartirmaydi. Faqat birinçi "
"mos qabul qilingan yeçim hisoblanadi. Musobaqa masalalari raund e’lon "
"qilingandan keyin hisobga ötadi. Köçirilgan deb topilgan yeçimga ball "
"berilmaydi."

msgid ""
"Faqat 1 ga 1 duellar uchun (hamma 1200 dan boshlaydi) va musobaqa reytingiga"
" ta’sir qilmaydi. Bir juftlik kuniga cheklangan miqdorda duel o‘ynashi "
"mumkin; raqib deyarli o‘ynamagan duel g‘alaba sifatida nishon va kunlik "
"vazifaga sanalmaydi."
msgstr ""
"Faqat 1 ga 1 duellar uçun (hamma 1200 dan boşlaydi) va musobaqa reytingiga "
"ta’sir qilmaydi. Bir juftlik kuniga çeklangan miqdorda duel öynaşi mumkin; "
"raqib deyarli öynamagan duel ğalaba sifatida nişon va kunlik vazifaga "
"sanalmaydi."

msgid ""
"Tizim hech kimni o‘zi jazolamaydi: belgilar faqat shubha, qarorni admin "
"kodni ko‘rib chiqib qabul qiladi. Qaror noto‘g‘ri deb hisoblasangiz, "
"musobaqa sahifasidagi «Apellyatsiya» orqali yozing: javob "
"bildirishnomangizda chiqadi."
msgstr ""
"Tizim heç kimni özi jazolamaydi: belgilar faqat şubha, qarorni admin kodni "
"körib çiqib qabul qiladi. Qaror notöğri deb hisoblasangiz, musobaqa "
"sahifasidagi «Apellyatsiya» orqali yozing: javob bildirişnomangizda çiqadi."

